{% extends 'base.html.twig' %}

{% block title %}Test IA · symfony base{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Share+Tech+Mono&family=JetBrains+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
        rel="stylesheet"
    >
    {{ reprise_entry_link_tags('app') }}
{% endblock %}

{% block body %}
    {#
        Console HAL 9000 — thème « 2001, l'Odyssée de l'espace » / tableau de bord Apollo 11.
        Le contrôleur Stimulus « test-ai » gère l'envoi, le flux SSE et l'œil rouge
        (états idle / typing / thinking / error portés par data-state).
    #}
    <div
        class="hal-console"
        data-controller="test-ai"
        data-test-ai-stream-url-value="{{ path('app_test_ai_stream') }}"
    >
        <div class="hal-console__stars" aria-hidden="true"></div>
        <div class="hal-console__grid-bg" aria-hidden="true"></div>
        <div class="hal-console__scanlines" aria-hidden="true"></div>

        <div class="hal-console__frame">
            <header class="hal-header">
                <div class="hal-header__brand">
                    <span class="hal-led" aria-hidden="true"></span>
                    <h1 class="hal-header__title">HAL <span>9000</span></h1>
                </div>
                <p class="hal-header__sub">
                    Heuristically programmed ALgorithmic computer
                </p>
                <ul class="hal-header__meta" aria-hidden="true">
                    <li class="hal-chip">DSKY</li>
                    <li class="hal-chip">GUIDANCE</li>
                    <li class="hal-chip">TELEMETRY</li>
                    <li class="hal-chip">LUNAR EAGLE</li>
                </ul>

                {#
                    Sélecteur d'agent : chaque bouton correspond à un rôle prédéfini
                    dont la description est injectée dans la requête de l'utilisateur
                    (voir AGENTS dans le contrôleur Stimulus). Un seul bouton peut être
                    actif à la fois (aria-pressed) ; aucun ne l'est par défaut.
                #}
                <div class="hal-agents" role="group" aria-label="Choix de l'agent">
                    <span class="hal-agents__label" aria-hidden="true">AGENT</span>
                    <button
                        type="button"
                        class="hal-agent"
                        data-test-ai-target="agent"
                        data-agent-id="standard"
                        data-action="click->test-ai#selectAgent"
                        aria-pressed="false"
                    >Standard</button>
                    <button
                        type="button"
                        class="hal-agent"
                        data-test-ai-target="agent"
                        data-agent-id="expert"
                        data-action="click->test-ai#selectAgent"
                        aria-pressed="false"
                    >Expert</button>
                    <button
                        type="button"
                        class="hal-agent"
                        data-test-ai-target="agent"
                        data-agent-id="serviteur"
                        data-action="click->test-ai#selectAgent"
                        aria-pressed="false"
                    >Serviteur</button>
                    <button
                        type="button"
                        class="hal-agent"
                        data-test-ai-target="agent"
                        data-agent-id="poete"
                        data-action="click->test-ai#selectAgent"
                        aria-pressed="false"
                    >Poète</button>
                </div>
            </header>

            <div class="hal-caution" aria-hidden="true">
                <span class="hal-caution__label">CAUTION &amp; WARNING</span>
                <span class="hal-lamp hal-lamp--amber"></span>
                <span class="hal-lamp hal-lamp--amber"></span>
                <span class="hal-lamp hal-lamp--red"></span>
                <span class="hal-lamp hal-lamp--green"></span>
                <span class="hal-lamp hal-lamp--green"></span>
                <span class="hal-lamp hal-lamp--blue"></span>
                <span class="hal-caution__state">NORMAL</span>
                <div class="hal-zone">
                    <p
                        id="ai-status"
                        class="hal-readout"
                        data-test-ai-target="status"
                        aria-live="polite"
                    >EN ATTENTE</p>
                </div>
            </div>

            <div class="hal-console__grid">
                <aside class="hal-panel hal-eyepanel" aria-label="Pupitre de HAL 9000">
                    <p class="hal-eyepanel__label">OPTICAL SENSOR · HAL 9000</p>

                    <div class="hal-zone hal-zone--eye">
                        <div
                            class="hal-eye"
                            data-test-ai-target="eye"
                            data-state="idle"
                            role="img"
                            aria-label="Œil rouge de HAL 9000"
                        >
                            <div class="hal-eye__barrel">
                                <div class="hal-eye__iris">
                                    <span class="hal-eye__sweep" aria-hidden="true"></span>
                                    <span class="hal-eye__pupil" aria-hidden="true"></span>
                                    <span class="hal-eye__glint" aria-hidden="true"></span>
                                </div>
                            </div>
                            <div
                                class="hal-eye__words"
                                data-test-ai-target="words"
                                aria-hidden="true"
                            ></div>
                        </div>
                    </div>

                    <div class="hal-zone hal-chronos" aria-label="Chronomètres">
                        <dl class="hal-chronos__list">
                            <div class="hal-chrono">
                                <dt>ANALYSE</dt>
                                <dd>
                                    <span
                                        class="hal-chrono__value"
                                        data-test-ai-target="chronoAnalyse"
                                        role="timer"
                                        aria-live="off"
                                    >00:00:00.00</span>
                                </dd>
                            </div>
                            <div class="hal-chrono">
                                <dt>RÉPONSE</dt>
                                <dd>
                                    <span
                                        class="hal-chrono__value"
                                        data-test-ai-target="chronoReponse"
                                        role="timer"
                                        aria-live="off"
                                    >00:00:00.00</span>
                                </dd>
                            </div>
                            <div class="hal-chrono">
                                <dt>TOTAL</dt>
                                <dd>
                                    <span
                                        class="hal-chrono__value"
                                        data-test-ai-target="chronoTotal"
                                        role="timer"
                                        aria-live="off"
                                    >00:00:00.00</span>
                                </dd>
                            </div>
                            <div class="hal-chrono">
                                <dt>SESSION</dt>
                                <dd>
                                    <span
                                        class="hal-chrono__value"
                                        data-test-ai-target="chronoSession"
                                        role="timer"
                                        aria-live="off"
                                    >00:00:00.00</span>
                                </dd>
                            </div>
                        </dl>
                    </div>

                    <dl class="hal-telemetry">
                        <div class="hal-gauge">
                            <dt>CPU</dt>
                            <dd><span class="hal-gauge__bar"><span class="hal-gauge__fill" style="--level: 64%"></span></span></dd>
                        </div>
                        <div class="hal-gauge">
                            <dt>MEMORY</dt>
                            <dd><span class="hal-gauge__bar"><span class="hal-gauge__fill" style="--level: 82%"></span></span></dd>
                        </div>
                        <div class="hal-gauge">
                            <dt>SIGNAL</dt>
                            <dd><span class="hal-gauge__bar"><span class="hal-gauge__fill" style="--level: 91%"></span></span></dd>
                        </div>
                        <div class="hal-gauge">
                            <dt>O₂</dt>
                            <dd><span class="hal-gauge__bar"><span class="hal-gauge__fill" style="--level: 97%"></span></span></dd>
                        </div>
                    </dl>

                    <div class="hal-zone hal-temp">
                        <div class="hal-temp__row">
                            <label for="ai-temperature" class="hal-temp__label">TEMP</label>
                            <input
                                id="ai-temperature"
                                data-test-ai-target="temperature"
                                data-action="input->test-ai#updateTemperature"
                                class="hal-temp__slider"
                                type="range"
                                min="0"
                                max="2"
                                step="0.1"
                                value="0.7"
                                aria-label="Température du modèle"
                            >
                            <output
                                class="hal-temp__value"
                                data-test-ai-target="temperatureValue"
                                for="ai-temperature"
                            >0.7</output>
                        </div>
                    </div>

                    <div class="hal-switches" aria-hidden="true">
                        <span class="hal-switch"></span>
                        <span class="hal-switch"></span>
                        <span class="hal-switch"></span>
                        <span class="hal-switch"></span>
                    </div>
                </aside>

                <section class="hal-panel hal-terminalpanel" aria-label="Terminal de chat">
                    <div class="hal-terminal">
                        <div class="hal-terminal__bar">
                            <span class="hal-terminal__title">TERMINAL 01</span>
                            <span class="hal-terminal__dots" aria-hidden="true">
                                <i></i><i></i><i></i>
                            </span>
                        </div>

                        <label for="ai-terminal" class="sr-only">Terminal de chat</label>
                        <div class="hal-terminal__field">
                            {# Transcript rendu : demandes en vert, réponses IA en Markdown (ambre). #}
                            <div
                                class="hal-terminal__screen"
                                data-test-ai-target="screen"
                                role="log"
                                aria-label="Conversation"
                            ></div>
                        </div>

                        <div class="hal-terminal__composer">
                            <label for="ai-terminal" class="sr-only">Votre demande</label>
                            <textarea
                                id="ai-terminal"
                                data-test-ai-target="terminal"
                                class="hal-terminal__input"
                                placeholder="> Écrivez votre demande puis cliquez sur « Envoyer »…"
                                aria-label="Votre demande"
                                spellcheck="false"
                            ></textarea>
                        </div>

                        <div class="hal-terminal__actions">
                            <button
                                type="button"
                                class="hal-btn hal-btn--primary"
                                data-test-ai-target="submit"
                                data-action="click->test-ai#send"
                            >Envoyer</button>
                            <button
                                type="button"
                                class="hal-btn hal-btn--ghost"
                                data-action="click->test-ai#reset"
                            >Effacer</button>
                            <span class="hal-terminal__hint" aria-hidden="true">F1 · HELP</span>
                        </div>
                    </div>

                    {# Cible Turbo : le serveur y pousse le texte cumulé de la réponse. #}
                    <div id="ai-output" hidden></div>
                </section>
            </div>

            <footer class="hal-footer" aria-hidden="true">
                {# Télémétrie du modèle : nom, tokens émis (prompt) / reçus (complétion)
                   et débit (tokens reçus par seconde), alimentés par l'événement SSE
                   « usage » puis animés à la manière d'un pupitre HAL 9000. #}
                <div class="hal-caution__telemetry">
                    <div class="hal-caution__item hal-caution__item--model">
                        <span class="hal-caution__key">MODÈLE</span>
                        <span
                            class="hal-caution__value hal-caution__value--model"
                            data-test-ai-target="model"
                        >—</span>
                    </div>
                    <div class="hal-caution__item">
                        <span class="hal-caution__key">TOKENS ÉMIS</span>
                        <span
                            class="hal-caution__value"
                            data-test-ai-target="tokensIn"
                        >0</span>
                    </div>
                    <div class="hal-caution__item">
                        <span class="hal-caution__key">TOKENS REÇUS</span>
                        <span
                            class="hal-caution__value"
                            data-test-ai-target="tokensOut"
                        >0</span>
                    </div>
                    <div class="hal-caution__item">
                        <span class="hal-caution__key">DÉBIT · TOK/S</span>
                        <span
                            class="hal-caution__value"
                            data-test-ai-target="speed"
                        >0.0</span>
                    </div>
                </div>
                <span class="hal-footer__item"><i class="hal-led"></i> SYS OK</span>
                <span class="hal-footer__item">SECTOR 21</span>
                <span class="hal-footer__item">UPLINK 1.2 kB/s</span>
                <span class="hal-footer__item hal-footer__item--right">EST. 1968 · 9000 SERIES</span>
            </footer>
        </div>
    </div>
{% endblock %}