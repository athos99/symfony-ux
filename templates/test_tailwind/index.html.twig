{% extends 'base.html.twig' %}

{% block title %}Test Tailwind · symfony base{% endblock %}

{% block body %}
    <div class="min-h-screen bg-base-200 py-10">
        <div class="mx-auto max-w-5xl space-y-10 px-4">
            <header class="text-center">
                <h1 class="text-4xl font-bold text-base-content">Tailwind CSS & DaisyUI</h1>
                <p class="mt-2 text-base-content/70">
                    Page de démonstration des composants DaisyUI et des utilitaires Tailwind.
                </p>
            </header>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Boutons</h2>
                    <div class="flex flex-wrap items-center gap-3">
                        <button class="btn btn-primary">Principale</button>
                        <button class="btn btn-secondary">Secondaire</button>
                        <button class="btn btn-accent">Accent</button>
                        <button class="btn btn-outline btn-error">Danger</button>
                        <button class="btn btn-ghost">Fantôme</button>
                        <button class="btn btn-link">Lien</button>
                        <button class="btn btn-success">Succès</button>
                        <button class="btn btn-warning">Attention</button>
                        <button class="btn btn-info">Info</button>
                    </div>
                    <div class="mt-3 flex flex-wrap items-center gap-3">
                        <button class="btn btn-sm btn-primary">Petit</button>
                        <button class="btn btn-md btn-primary">Moyen</button>
                        <button class="btn btn-lg btn-primary">Grand</button>
                        <button class="btn btn-primary btn-disabled">Désactivé</button>
                        <button class="btn btn-circle btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                        </button>
                    </div>
                </div>
            </section>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Typographie</h2>
                    <div class="space-y-3">
                        <p class="text-2xl font-semibold">Texte 2xl</p>
                        <p class="text-xl">Texte xl</p>
                        <p class="text-lg">Texte large (lg)</p>
                        <p class="text-base">Texte de base (base)</p>
                        <p class="text-sm text-base-content/70">Texte petit (sm) et atténué</p>
                        <p class="text-xs text-base-content/50">Texte très petit (xs)</p>
                        <div class="flex flex-wrap gap-2 pt-2">
                            <span class="badge badge-primary">Primaire</span>
                            <span class="badge badge-secondary">Secondaire</span>
                            <span class="badge badge-accent">Accent</span>
                            <span class="badge badge-success">Succès</span>
                            <span class="badge badge-warning">Attention</span>
                            <span class="badge badge-error">Erreur</span>
                            <span class="badge badge-info">Info</span>
                            <span class="badge badge-outline">Outline</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Formulaires</h2>
                    <form class="grid gap-4 md:grid-cols-2">
                        <div class="form-control">
                            <label class="label" for="name">
                                <span class="label-text">Nom</span>
                                <span class="label-text-alt text-error">*</span>
                            </label>
                            <input type="text" id="name" placeholder="Jean Dupont" class="input input-bordered" />
                        </div>

                        <div class="form-control">
                            <label class="label" for="email">
                                <span class="label-text">E-mail</span>
                            </label>
                            <input type="email" id="email" placeholder="jean.dupont@example.com" class="input input-bordered" />
                        </div>

                        <div class="form-control">
                            <label class="label" for="select">
                                <span class="label-text">Ville</span>
                            </label>
                            <select id="select" class="select select-bordered">
                                <option disabled selected>Choisir une ville</option>
                                <option>Paris</option>
                                <option>Lyon</option>
                                <option>Marseille</option>
                            </select>
                        </div>

                        <div class="form-control">
                            <label class="label" for="date">
                                <span class="label-text">Date</span>
                            </label>
                            <input type="date" id="date" class="input input-bordered" />
                        </div>

                        <div class="form-control md:col-span-2">
                            <label class="label" for="message">
                                <span class="label-text">Message</span>
                            </label>
                            <textarea id="message" placeholder="Votre message..." class="textarea textarea-bordered h-24"></textarea>
                        </div>

                        <div class="flex flex-wrap items-center gap-6 md:col-span-2">
                            <div class="form-control flex-row items-center gap-2">
                                <input type="checkbox" id="check" class="checkbox checkbox-primary" checked />
                                <label for="check" class="cursor-pointer">J'accepte les conditions</label>
                            </div>
                            <div class="form-control flex-row items-center gap-2">
                                <input type="radio" name="plan" id="plan-a" class="radio radio-primary" checked />
                                <label for="plan-a" class="cursor-pointer">Option A</label>
                            </div>
                            <div class="form-control flex-row items-center gap-2">
                                <input type="radio" name="plan" id="plan-b" class="radio radio-primary" />
                                <label for="plan-b" class="cursor-pointer">Option B</label>
                            </div>
                            <div class="form-control">
                                <label class="flex cursor-pointer items-center gap-2">
                                    <span class="label-text">Actif</span>
                                    <input type="checkbox" class="toggle toggle-primary" />
                                </label>
                            </div>
                        </div>

                        <div class="md:col-span-2">
                            <div class="flex flex-wrap gap-3">
                                <button type="submit" class="btn btn-primary">Envoyer</button>
                                <button type="reset" class="btn btn-outline">Annuler</button>
                            </div>
                        </div>
                    </form>
                </div>
            </section>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Alertes & Notifications</h2>
                    <div class="space-y-3">
                        <div role="alert" class="alert alert-info">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>Un message informatif.</span>
                        </div>
                        <div role="alert" class="alert alert-success">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>Opération réussie.</span>
                        </div>
                        <div role="alert" class="alert alert-warning">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <span>Attention requise.</span>
                        </div>
                        <div role="alert" class="alert alert-error">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>Une erreur est survenue.</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Cartes & Avatar</h2>
                    <div class="flex flex-wrap items-center gap-6">
                        <div class="card w-80 bg-neutral text-neutral-content shadow-md">
                            <div class="card-body">
                                <h3 class="card-title">Carte neutre</h3>
                                <p>Carte avec un fond neutre et un titre.</p>
                                <div class="card-actions justify-end">
                                    <button class="btn btn-primary btn-sm">Action</button>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="avatar">
                                <div class="w-16 rounded-full">
                                    <img alt="Avatar" src="{{ asset('img/avatar.svg') }}" />
                                </div>
                            </div>
                            <div>
                                <div class="font-semibold">Jean Dupont</div>
                                <div class="text-sm opacity-70">Développeur Symfony</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Étapes & Progression</h2>
                    <div class="space-y-4">
                        <ul class="steps">
                            <li class="step step-primary">Création du compte</li>
                            <li class="step step-primary">Vérification de l'e-mail</li>
                            <li class="step">Configuration du profil</li>
                            <li class="step">Terminé</li>
                        </ul>
                        <div class="flex flex-col gap-2">
                            <progress class="progress progress-primary" value="70" max="100"></progress>
                            <progress class="progress progress-success" value="40" max="100"></progress>
                            <div class="radial-progress text-primary" style="--value:60" role="progressbar">60%</div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Navigation</h2>
                    <nav class="menu bg-base-200 w-full rounded-box p-2">
                        <ul class="flex-row flex-wrap gap-2">
                            <li><a class="active">Accueil</a></li>
                            <li><a>Projets</a></li>
                            <li><a>Contact</a></li>
                        </ul>
                    </nav>
                    <div class="mt-3 flex flex-wrap items-center gap-3">
                        <div class="breadcrumbs text-sm">
                            <ul>
                                <li><a>Accueil</a></li>
                                <li><a>Projets</a></li>
                                <li>Test Tailwind</li>
                            </ul>
                        </div>
                        <div class="pagination flex gap-1">
                            <button class="btn btn-sm">«</button>
                            <button class="btn btn-sm btn-active btn-primary">1</button>
                            <button class="btn btn-sm">2</button>
                            <button class="btn btn-sm">3</button>
                            <button class="btn btn-sm">»</button>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Tabs & Accordion</h2>
                    <div class="tabs tabs-boxed">
                        <a class="tab tab-active">Profil</a>
                        <a class="tab">Messages</a>
                        <a class="tab">Paramètres</a>
                    </div>
                    <div class="mt-4 space-y-2">
                        <div class="collapse collapse-arrow border border-base-300 rounded-box">
                            <input type="radio" name="accordion" checked />
                            <div class="collapse-title font-semibold">Section 1</div>
                            <div class="collapse-content text-sm text-base-content/70">
                                Contenu de la première section.
                            </div>
                        </div>
                        <div class="collapse collapse-arrow border border-base-300 rounded-box">
                            <input type="radio" name="accordion" />
                            <div class="collapse-title font-semibold">Section 2</div>
                            <div class="collapse-content text-sm text-base-content/70">
                                Contenu de la deuxième section.
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h2 class="card-title">Utilitaires Tailwind</h2>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        <div class="rounded-xl bg-primary p-6 text-primary-content">
                            <p class="font-bold">Couleur primary</p>
                            <p class="text-sm opacity-80">Padding, coins arrondis, ombre.</p>
                        </div>
                        <div class="rounded-xl bg-secondary p-6 text-secondary-content">
                            <p class="font-bold">Couleur secondary</p>
                            <p class="text-sm opacity-80">Grille responsive.</p>
                        </div>
                        <div class="rounded-xl bg-accent p-6 text-accent-content">
                            <p class="font-bold">Couleur accent</p>
                            <p class="text-sm opacity-80">Espacement et typographie.</p>
                        </div>
                    </div>
                </div>
            </section>

            <footer class="footer bg-neutral text-neutral-content items-center rounded-box p-4">
                <aside class="items-center">
                    <p>Copyright © 2024 - Symfony UX</p>
                </aside>
                <nav class="gap-2">
                    <a class="link link-hover">Mentions légales</a>
                    <a class="link link-hover">Confidentialité</a>
                </nav>
            </footer>
        </div>
    </div>
{% endblock %}